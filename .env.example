# I Wear Organic — local secrets template
# Copy to .env.local and fill values. Never commit real secrets.

# --- Printify ---
PRINTIFY_API_TOKEN=
# PRINTIFY_API_KEY=
# Required when the token can see multiple shops (pin I Wear Organic, not Blend):
PRINTIFY_SHOP_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# ALLOW_LIVE_STRIPE_CHECKOUT=false

# --- Firebase Admin (isolated project; not Blend) ---
# Path relative to repo root, or one-line service-account JSON:
FIREBASE_SERVICE_ACCOUNT_KEY=./secrets/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_FIRESTORE_DATABASE_ID=
# FIREBASE_PROJECT_ID=

# --- Catalog ---
# Defaults to fixtures when Printify is missing outside production:
# ALLOW_CATALOG_FIXTURES=true
