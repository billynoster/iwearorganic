rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Fields:
    //   - id: string (immutable)
    //   - email: string (email format; may sync to Auth email after verify)
    //   - firstName: string (max 50 chars)
    //   - lastName: string (max 50 chars)
    //   - phone: string (optional profile phone, max 30 chars — not SMS MFA)
    //   - hasChosenName: bool (optional; set when customer saves Profile)
    //   - displayName: string (optional, max 100 chars)
    //   - dateJoined: timestamp (immutable)
    //   - vibe: string (optional, max 50 chars)
    //   - stylePreferences: string (optional, max 500 chars)
    //   - shippingInfo: map (optional, specific fields)
    //
    // Collection: /users/{userId}/cartItems/{cartItemId}
    // Fields:
    //   - id: string (immutable)
    //   - productId: string
    //   - variantId: number
    //   - quantity: number (positive)
    //   - productData: string (JSON string, max 2000 chars)
    //   - variantData: string (JSON string, max 2000 chars)
    //   - addedAt: timestamp
    //
    // Collection: /users/{userId}/wishlistItems/{itemId}
    // Fields:
    //   - id: string (immutable)
    //   - productId: string
    //   - productData: string (JSON string, max 2000 chars)
    //   - addedAt: timestamp
    //
    // Collection: /users/{userId}/blendboard/{boardId}
    // Fields:
    //   - items: list (max 50 items)
    //   - updatedAt: timestamp
    //
    // Collection: /orders/{orderId}
    // Fields:
    //   - id: string (immutable)
    //   - userId: string (immutable)
    //   - email: string (email format, immutable)
    //   - status: string (enum)
    //   - totalAmount: number (positive)
    //   - items: list (max 50 items, JSON strings)
    //   - shippingInfo: string (JSON string, max 2000 chars)
    //   - createdAt: timestamp (immutable)
    //
    // Collection: /reviews/{reviewId}
    // Fields:
    //   - id: string (immutable)
    //   - productId: string
    //   - userId: string (immutable)
    //   - userName: string (max 50 chars)
    //   - rating: number (1-5)
    //   - comment: string (max 1000 chars)
    //   - createdAt: timestamp (immutable)
    //
    // Collection: /customers/{customerId}
    // Fields:
    //   - stripeId: string
    //   - stripeLink: string (optional)
    //
    // Collection: /customers/{customerId}/checkout_sessions/{sessionId}
    // Fields:
    //   - mode: string (enum)
    //   - success_url: string (uri)
    //   - cancel_url: string (uri)
    //   - line_items: list
    //   - url: string (uri, optional)
    //   - error: map (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "billynoster@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['id', 'email', 'firstName', 'lastName', 'phone', 'hasChosenName', 'dateJoined', 'vibe', 'stylePreferences', 'shippingInfo', 'addresses', 'communicationPrefs', 'role', 'displayName', 'photoURL']) &&
             data.id == request.auth.uid &&
             data.email is string &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 50)) &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 50)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30)) &&
             (!('hasChosenName' in data) || data.hasChosenName is bool) &&
             data.dateJoined is timestamp &&
             (!('vibe' in data) || (data.vibe is string && data.vibe.size() <= 50)) &&
             (!('stylePreferences' in data) || (data.stylePreferences is string && data.stylePreferences.size() <= 500)) &&
             (!('addresses' in data) || data.addresses is list) &&
             (!('communicationPrefs' in data) || data.communicationPrefs is map) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000));
    }

    // Email may change only to match the verified Auth token email (post verifyBeforeUpdateEmail).
    function emailChangeIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
             request.resource.data.email == request.auth.token.email;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId}/preferences/{preferenceId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && areImmutableFieldsUnchanged(['id', 'dateJoined']) && emailChangeIsSafe();
    }

    match /users/{userId}/cartItems/{cartItemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/wishlistItems/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/blendboard/{boardId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'printifyOrderId', 'shippingInfo']) &&
        request.resource.data.status == 'paid' &&
        resource.data.status == 'pending'
      );
    }


    match /videos/{videoId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    match /creators/{creatorId} {
      allow read: if true;
      allow write: if isOwner(creatorId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isOwner(customerId) || isAdmin();
    }

    match /customers/{customerId}/checkout_sessions/{sessionId} {
      allow read, write: if isOwner(customerId) || isAdmin();
    }
  }
}
